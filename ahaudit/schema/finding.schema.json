{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.c01n31.net/c01n31pan1c/agent-harness-audit/-/raw/main/ahaudit/schema/finding.schema.json",
  "title": "agent-harness-audit finding",
  "type": "object",
  "required": ["schema_version", "harness", "generated_by", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "harness": {"type": "string"},
    "generated_by": {
      "type": "object",
      "required": ["tool", "version"],
      "properties": {
        "tool": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["check", "title", "severity", "claim"],
      "additionalProperties": false,
      "properties": {
        "check": {"type": "string", "pattern": "^AHA-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "claim": {"type": "string", "minLength": 1},
        "evidence": {"type": "object"},
        "remediation": {"type": "string"},
        "taxonomy": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(PI|IPI|EX|OUT|TC|AG|SB|DL|DEF|EV)-[0-9]{3}$"
          }
        },
        "confidence": {
          "type": "string",
          "enum": ["declared", "observed", "inferred"]
        }
      }
    }
  }
}
